{
  "compilerOptions": {
    "target": "ESNEXT",
    "module": "commonjs",
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "typeRoots": [
      "types",
      "./node_modules/@types"
    ],
    "lib": [
      "ESNEXT",
      "dom"
    ],
  },
  "include": [
    "./src/**/*.ts",
  ]
}
