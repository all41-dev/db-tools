{
  "name": "@all41-dev/db-tools",
  "version": "1.5.0",
  "description": "manage databade updates",
  "main": "./dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "test": "echo \"no test specified\" && exit 0",
    "lint": "eslint src/**",
    "start": "node ./dist/test.js",
    "build": "tsc",
    "ncu:view": "ncu -x ,sequelize,typescript",
    "ncu:upd": "ncu -x sequelize,typescript -u && npm i",
    "preversion": "run-p test lint build",
    "postversion": "git push && git push --tags && npm publish --access public"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "keywords": [
    "database",
    "update",
    "db",
    "sequelize",
    "sequelize-typescript"
  ],
  "author": "all41 <eric@all41.dev>",
  "license": "MIT",
  "dependencies": {
    "basic-ftp": "^6.0.1",
    "cron": "^4.4.0",
    "semver": "^7.8.5",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1",
    "@types/validator": "^13.15.10",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "mariadb": "^3.5.3",
    "npm-run-all": "^4.1.5",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^6.0.1",
    "typescript-eslint": "^8.63.0",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0"
  },
  "volta": {
    "node": "26.5.0"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
